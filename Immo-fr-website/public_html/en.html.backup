    <!-- What people say -->

    <!-- FAQs -->
    <div class="faqs" id="faqs">
        <div class="faqs-content wrapper">
            <h2 class="heading" id="heading">
                FAQs
            </h2>

            <!-- FAQ Content -->
            <!-- FAQ Content -->
            <div class="faqs-right">
                <div class="accordions">
                    <!-- start of accordion -->
                    <div class="accordion">
                        <h4 class="accordion__title">How much does the subscription cost?</h4>
                        <div class="accordion__content cf">
                            <p>The subscription for Agents is €365 per year. This includes upload of unlimited properties.</p>
                        </div>
                    </div>
                    <!-- end of accordion -->
                    <!-- start of accordion -->
                    <div class="accordion">
                        <h4 class="accordion__title">How do I register?</h4>
                        <div class="accordion__content cf">
                            <p>To register, simply click on the `Create an account` button. This will redirect 
                                you to add your details and to the payment section.</p>
                        </div>
                    </div>
                    <!-- end of accordion -->
                    <!-- start of accordion -->
                    <div class="accordion">
                        <h4 class="accordion__title">I'm an agency with hundreds of properties - how does it work?</h4>
                        <div class="accordion__content cf">
                            <p>As agents have their own property portfolios, each registered agent is 
                                allowed to subscribe to the platform. If you are an agency with no agents, then 
                                the agency will subscribe.
                            </p>
                        </div>
                    </div>
                    <!-- end of accordion -->
                    <!-- start of accordion -->
                    <div class="accordion">
                        <h4 class="accordion__title">Do I need to re-register each year?</h4>
                        <div class="accordion__content cf">
                            <p>No. Renewals will be automatic each year. If you no longer wish to subscribe, 
                                then we must be notified 28 days before the renewal date.
                            </p>
                        </div>
                    </div>
                    <!-- end of accordion -->
                </div>
            </div>
            <!-- FAQ Content -->
            <!-- FAQ Content -->
        </div>
    </div>
    <!-- FAQs -->

