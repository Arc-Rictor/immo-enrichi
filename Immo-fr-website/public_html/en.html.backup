<!-- header -->
<header>

    <div class="header">
        <div class="header-nav-container">
            <div class="home-logo">
                <!-- Logo removed -->
            </div>

            <div class="nav-links">
               
                <ul>
                    <li><a href="#about">About</a></li>
                    <li><a href="#features">Features</a></li>
                    <li><a href="#latest-props">Latest Properties</a></li>
                    <li><a href="#testimonials">Testimonials</a></li>
                    <li><a href="#faqs">FAQs</a></li>
                    <li><a href="mailto:info-imf@mail.com?subject=Enquiry from the website">Contact Us</a></li>
                </ul>
               
            </div>
            <!-- log in -->
            <div class="log-in">
                <div class="language">
                    <a class="change" href="fr">
                        <p>FR</p>
                        <img class="flag" src="./france.png" alt="country flag" onclick="changeLanguage()">
                    </a>
                    
                    <img src="./arrow-down.png" alt="" class="arrow">
                </div>

                <a class="head-sign" href="https://app.immobiliermatrixfrance.fr/register">Sign up</a>

                <a href="https://app.immobiliermatrixfrance.fr/login" class="log btn-header">Log in</a>
            </div>
            <!-- log in -->

            <!-- Mobile menu -->
            <div class="mobile-nav-container">
                <div class="nav-toggle">
                    <span></span>
                    <span></span>
                    <span></span>
                </div>
            </div>

            <div class="mobile-nav-menu">
                <ul class="header-mob-nav">
                    <li><a href="#about">About</a></li>
                    <li><a href="#features">Features</a></li>
                    <li><a href="#latest-props">Latest Properties</a></li>
                    <li><a href="#testimonials">Testimonials</a></li>
                    <li><a href="#faqs">FAQs</a></li>
                    <li><a href="mailto:info-imf@mail.com?subject=Enquiry from the website">Contact Us</a></li>
                    <div class="log-mob">
                        <li><a href="https://app.immobiliermatrixfrance.fr/register">Sign up</a></li>
                        <li><a href="https://app.immobiliermatrixfrance.fr/login">Log in</a></li>
                    </div>
                </ul>
            </div>
            <!-- Mobile menu -->
        </div>
    </div>
</header>
<!-- header -->



<body class="english">
    <div class="homepage-hero">
        <div class="hero-gradient"></div>
        <div class="hero-gradient-white"></div>
        <div class="wrapper">
            <div class="hero-heading">
                <h1 class="hero-heading-content"></h1>
            </div>
    
            <div class="sub-heading">
                <h1 class="sub-heading">Agents of The Future</h1>
                <h2>Designed for all Agents in France, our new platform aims to boost sales, attract buyers, and secure new listings.</h2>

                <h2>
 Our innovative concept provides Real Estate Agents with the tools to satisfy every new buyer who walks through their door.
                </h2>

                <h2>Agents can now show clients a wide range of properties: those from their own listings, as well as those from other Agents in the area. This allows buyers to get an overview of all properties that suit them without having to visit multiple agencies!
                </h2>
                
                <h2>
                    Although the goal remains for the buyer to choose properties listed by the Agent who presents them, the latter can now offer a complete experience by showing the buyer all the options available on the market, even in different regions.
                </h2>
                
                <h2>
                    Furthermore, with our system, if the sold property belongs to another Agent, our initial Agent still receives a share of the commission, fostering a spirit of collaboration where no sale is missed.
                </h2>
            </div>
    
            <div class="sign-up">
                <a href="https://app.immobiliermatrixfrance.fr/register" class="btn">
                    Sign up today
                </a>
    
               <div class="registered">
                    <p>Already registered?</p>
                    <a href="https://app.immobiliermatrixfrance.fr/login">Log in now</a>
               </div>
            </div>
            
            <div class="sub-heading">
                <h2>In addition to being a proven concept that keeps the market dynamic, our solution is affordable for all Agents.</h2>
                
                <h2>
                    Everyone can subscribe to our platform for the unbeatable price of €365 per year. This subscription allows Agents to upload an unlimited number of properties.
                </h2>
            </div>

            <div class="info-banner">
                <div class="wrapper info" style="justify-content: center;">
                    <!-- repeater -->
                    <div class="info-banner-content">
                        <h3 class="info-title" id="title">
                            For Estate Agents
                        </h3>
        
                        <p class="info-text" id="paragraphs">
                            <!-- Upload unlimited properties, extending your shop window for sellers and buyers. -->
                            With your personal control panel you can
                            upload unlimited properties and extend your shop window for sellers and buyers.
                            The opportunities are there for you!
    
                        </p>
        
                        <a href="https://app.immobiliermatrixfrance.fr/register" class="create">Create an account now</a>
                    </div>
                    <!-- repeater -->
                </div>
            </div>

        <!--    <div class="hero-image">
                <img src="./hero.png" alt="">
            </div>
        -->
        </div>
    </div>
    <!-- fifty fifty -->
    <div class="cta-info">
        <div class="wrapper cta">
            <div class="left">
    
                <p class="sub-heading" id="paragraphs">
Subscribed Agents benefit from their own personal control interface, which allows them to manage their listings by adding and removing properties at will, or even search for properties on behalf of their buyers.
                </p>
                
                <p class="sub-heading" id="paragraphs">
At the top right of the control interface is an Alert Icon that notifies Agents when a seller seeks representation. The Agent simply clicks on the Alert Icon, which provides the seller's contact information. You can then contact this seller and schedule the usual appointment. However, since all subscribed Agents have access to this feature, it is crucial to act quickly to be the first to respond and secure the listing!
                                </p>
    
            </div>
    
            <div class="right">
                <img class="bgh" src="./hero.png" alt="">
            </div>
        </div>
    </div>

    <!-- fifty fifty -->
    <div class="cta-info">
        <div class="wrapper cta">
            <div class="left">
                <h2 class="heading" id="small-heading">Discover properties from every agency in France, in one place</h2>

                <p class="sub-heading" id="paragraphs">
                    With over 50,000 agents in France, the opportunities are 
                    endless.
                    Our unique platform connects agents in 
                    one place, 
                    all for a single annual fee.
                </p>

                <div class="sign-up">
                    <a href="https://app.immobiliermatrixfrance.fr/register" class="btn">
                        Sign up today
                    </a>
        
                   <div class="registered">
                        <p>Already registered?</p>
                        <a href="https://app.immobiliermatrixfrance.fr/login">Log in now</a>
                   </div>
                </div>
            </div>

            <div class="right">
                <img class="bg" src="./cta.png" alt="">
            </div>
        </div>
    </div>
    <!-- fifty fifty -->

    <!-- list banner reverse -->
    <div class="list-banner-cta reverse-banner-cta">
        <div class="wrapper list-banner reverse">
            <div class="left">
                <img src="./list2.png" alt="">
            </div>

            <div class="right">
                <h2 class="heading" id="small-heading">
                    The latest properties with live information
                </h2>

                <p class="sub-heading" id="paragraphs">
                    Our property listings are updated in real time, so you’ll be able to see new properties listed as soon as they land, meaning you could be the first to put in an offer on property that’s in high demand.
                </p>

                <div class="sign-up">
                    <a href="https://app.immobiliermatrixfrance.fr/register" class="btn">
                        Sign up today
                    </a>
        
                   <div class="registered">
                        <p>Already registered?</p>
                        <a href="https://app.immobiliermatrixfrance.fr/login">Log in now</a>
                   </div>
                </div>
            </div>
        </div>
    </div>
    <!-- list banner reverse -->

    <!-- main cta latest properties -->
    <div class="latest-cta" id="latest-props">
